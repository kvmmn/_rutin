# Configure in Vercel Project Settings > Environment Variables.
# Never commit actual credentials to GitHub.

# Google Sheets (service account)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google OAuth (sign-in) + session
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_EMAIL=
AUTH_SESSION_SECRET=

# Temporary: skip Google login gate (default true in code if unset).
# Set to false to require sign-in again: AUTH_DISABLED=false
AUTH_DISABLED=true

# Web Push (MVP meal nudges) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push service, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# Protect /api/cron/meal-nudges (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
